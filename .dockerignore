# Keeps the Docker build context small.
#
# The `dir/*` form rather than `dir/` is deliberate: it excludes the contents
# while leaving the directory itself includable, which is what lets the `!`
# exceptions below re-admit the six artifact files the API actually loads.
#
# The important exclusion is data/states.npy at 5.9 GB. The API never needs it —
# the U-Net predicts the state fields from geology, so only constants.npy
# (125 MB) is required.

.git/
.github/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Model artifacts: admit exactly what api/service.py loads, nothing else.
#
# Anchored with a leading slash to mirror .gcloudignore, where an unanchored
# `data/*` also swallowed src/data/ and broke the container at startup. Docker
# already anchors these patterns, so the slash is a no-op here — it is present
# so the two files stay diff-identical and cannot drift apart.
/data/*
!/data/constants.npy
!/data/stats.json

/checkpoints/*
!/checkpoints/unet_small_best.pt

/outputs/*
!/outputs/xgb_classifier.ubj
!/outputs/shap_features.json
!/outputs/xgb_results.json

# Not needed at runtime.
/notebooks/
/kaggle/
/docs/
/runtime_artifacts/
/api_artifacts/
/figures/
*.ipynb
*.pdf
*.mdb
*.log
.DS_Store

# The Streamlit dashboard is a separate local tool, not part of the API image.
/app/dashboard.py
